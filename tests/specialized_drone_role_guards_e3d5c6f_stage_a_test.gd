extends Node3D
## E3d5c6f Stage A isolated F6 contract checks. No live drone movement.
const Scope := preload("res://scenes/core/playable_specialized_drones_e3d5c6f.tscn")
const Press := preload("res://data/buildings/prototype_ammunition_press.tres")

func _ready() -> void:
	call_deferred("_run")

func _run() -> void:
	var scope := Scope.instantiate() as Node3D
	add_child(scope)
	var authority := scope.get_node("RoleContracts") as SpecializedDroneRoleContractsE3d5c6f
	assert(scope.scene_file_path == authority.EXACT_SCOPE)
	assert(authority.enable_stage_a_contracts and authority.lease_count() == 0)
	print("PASS A: exact opt-in scene and default-empty role ledger")
	var queue := BlueprintConstructionPriorityQueue.new()
	var registry := BlueprintConstructionSiteStagingRegistry.new()
	var escrow := BlueprintConstructionMaterialEscrow.new()
	var site := ConstructionSite.new()
	var logistics := Node3D.new()
	var builder := Node3D.new()
	scope.add_child(queue)
	scope.add_child(registry)
	scope.add_child(escrow)
	scope.add_child(logistics)
	scope.add_child(builder)
	assert(site.setup_with_definition_job(Press))
	site.set_process(false)
	scope.add_child(site)
	assert(site.job.state == ConstructionJob.State.PLANNED)
	assert(authority.claim_logistics(site, logistics, queue, registry, null) == 0)
	assert(not authority.claim_builder(1, builder))
	assert(authority.seal_handoff(1, escrow) == 0)
	print("PASS B: PLANNED sites never gain logistics, builder or handoff permission")
	assert(site.job.set_priority(ConstructionJob.Priority.HIGH))
	assert(site.job.state == ConstructionJob.State.PLANNED)
	assert(site.job.authorize())
	assert(queue.register_queued_site(site))
	assert(authority.claim_logistics(site, logistics, queue, registry, null) == 0)
	assert(authority.lease_count() == 0)
	print("PASS C: priority and authorization alone cannot bypass original pinned staging")
	assert(authority.seal_handoff(42, escrow) == 0)
	assert(not authority.receipt_valid(42))
	assert(not authority.claim_builder(42, logistics))
	assert(not authority.claim_builder(42, builder))
	assert(not authority.revoke(42))
	assert(escrow.held_count() == 0 and site.job.get_progress() == 0.0)
	print("PASS D: invalid receipts/duplicate roles cannot grant workers, materials or progress")
	authority.enable_stage_a_contracts = false
	assert(authority.claim_logistics(site, logistics, queue, registry, null) == 0)
	assert(not authority.receipt_valid(1))
	print("PASS E: disabled authority fails closed")
	authority.enable_stage_a_contracts = true
	assert(site.job.cancel())
	assert(authority.claim_logistics(site, logistics, queue, registry, null) == 0)
	assert(authority.lease_count() == 0 and escrow.held_count() == 0)
	print("PASS F: cancelled job refuses leasing and cannot fabricate a refund")
	scope.queue_free()
	print("E3d5c6f Stage A guard fixture: 6/6 sections passed")
